[Unit]
# Older text server: server/server.py on 127.0.0.1:4100, from ~/lumen/server.py.
# The desktop server (desktop/server.py, port 8787) is lumen-server.service.
Description=Lumen text server (server/server.py) on 127.0.0.1:4100

[Service]
WorkingDirectory=%h/lumen
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -I %h/lumen/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
